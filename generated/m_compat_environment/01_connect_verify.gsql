\set ON_ERROR_STOP on
\set AUTOCOMMIT on
-- Required for both NEW and explicitly approved REUSE routes.
-- The next line is a gsql client command, NOT server SQL.
\connect m_factor_test
SELECT 1 / CASE WHEN current_database() = 'm_factor_test' AND (SELECT datcompatibility FROM pg_catalog.pg_database WHERE datname = current_database()) = 'M' THEN 1 ELSE 0 END AS m_database_verified;
SELECT current_database(), datcompatibility FROM pg_catalog.pg_database WHERE datname = current_database();
